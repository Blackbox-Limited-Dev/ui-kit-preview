#!/bin/sh
. "$(dirname "$0")/common.sh"

# Block unoptimized images. Staged SVG/PNG/JPG under src/ and public/ are
# checked (never rewritten — a lossy re-encode is the developer's call, not
# the hook's). Fix with: npm run assets:optimize
staged_img=$(git diff --cached --name-only --diff-filter=ACM -- 'src/**/*.svg' 'src/**/*.png' 'src/**/*.jpg' 'src/**/*.jpeg' 'public/**/*.svg' 'public/**/*.png' 'public/**/*.jpg' 'public/**/*.jpeg')

if [ -n "$staged_img" ]; then
  echo "▸ assets (svgo + sharp)…"
  if ! printf '%s\n' "$staged_img" | xargs node scripts/optimize-assets.mjs --check; then
    echo "✖ Pre-commit blocked: unoptimized assets staged (see above)."
    exit 1
  fi
fi

npx nano-staged
